# Required
ANTHROPIC_API_KEY=sk-ant-...

# MCP server URL (default: http://localhost:8000/mcp)
# Set to your Railway deployment URL in production
MCP_SERVER_URL=http://localhost:8000/mcp

# Accessibility API (Railway endpoint with transit .db files)
# In production, point to Railway: https://your-app.up.railway.app/api/accessibility
# NEXT_PUBLIC_ACCESSIBILITY_API_URL=

# Optional — accessibility / transport features (local dev only)
# PRIM_API_KEY=
# IDFM_API_KEY=
